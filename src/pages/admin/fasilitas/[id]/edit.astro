---
export const prerender = false;
import Layout from '../../../../layouts/Layout.astro';
import { supabaseServer } from '../../../../lib/supabase';

const { id } = Astro.params;
const client = await supabaseServer(Astro.cookies);

const { data: item, error: errFetch } = await client.from('fasilitas').select('*').eq('id', id).single();

if (errFetch || !item) {
  return Astro.redirect('/admin/fasilitas?error=Fasilitas+tidak+ditemukan');
}

const error = Astro.url.searchParams.get('error');
---
<Layout title={`Edit Fasilitas: ${item.judul} — Panel Admin`}>
  <div class="min-h-screen bg-brand-50">
    <header class="bg-white border-b border-brand-100">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 py-5">
        <a href="/admin/fasilitas" class="text-sm text-ink/50 hover:text-brand-600">&larr; Kembali ke Daftar Fasilitas</a>
        <h1 class="font-display font-extrabold text-2xl mt-1">Edit Fasilitas</h1>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
      {error && <p class="text-sm bg-red-50 text-red-600 border border-red-100 rounded-lg px-4 py-2.5 mb-6">{error}</p>}

      <form method="POST" action="/api/fasilitas/update" enctype="multipart/form-data" class="space-y-6 bg-white rounded-2xl border border-brand-100 p-6 sm:p-8 shadow-sm">
        <input type="hidden" name="id" value={item.id} />

        <div>
          <label for="judul" class="text-sm font-semibold text-ink">Judul Fasilitas <span class="text-red-500">*</span></label>
          <input id="judul" name="judul" type="text" value={item.judul} required class="mt-1 w-full px-4 py-2.5 rounded-xl bg-brand-50 border border-brand-100 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>

        <div>
          <label for="deskripsi" class="text-sm font-semibold text-ink">Deskripsi Fasilitas <span class="text-red-500">*</span></label>
          <textarea id="deskripsi" name="deskripsi" rows="3" required class="mt-1 w-full px-4 py-2.5 rounded-xl bg-brand-50 border border-brand-100 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">{item.deskripsi}</textarea>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="gambar_file" class="text-sm font-semibold text-ink">Foto Saat Ini & Ubah Foto</label>
            {item.gambar_url && (
              <div class="my-2">
                <img src={item.gambar_url} alt={item.judul} class="w-32 h-20 object-cover rounded-xl border border-brand-100 shadow-sm" />
              </div>
            )}
            <input id="gambar_file" name="gambar_file" type="file" accept="image/*" class="mt-1 w-full text-xs text-ink/70 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-brand-100 file:text-brand-700 hover:file:bg-brand-200">
            <p class="text-[11px] text-ink/50 mt-1">Biarkan kosong jika tidak ingin menguubah gambar.</p>
          </div>

          <div>
            <label for="icon" class="text-sm font-semibold text-ink">Icon (FontAwesome Name)</label>
            <input id="icon" name="icon" type="text" value={item.icon || ''} placeholder="Contoh: computer, book-open" class="mt-1 w-full px-4 py-2.5 rounded-xl bg-brand-50 border border-brand-100 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
        </div>

        <div>
          <label for="urutan" class="text-sm font-semibold text-ink">Urutan Tampilan</label>
          <input id="urutan" name="urutan" type="number" value={item.urutan} min="0" class="mt-1 w-32 px-4 py-2.5 rounded-xl bg-brand-50 border border-brand-100 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>

        <div class="pt-2 flex justify-end gap-3">
          <a href="/admin/fasilitas" class="px-5 py-2.5 rounded-xl border border-brand-200 text-ink/70 text-sm font-semibold hover:bg-brand-50">Batal</a>
          <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-2.5 rounded-xl transition-colors text-sm shadow-md">Simpan Perubahan</button>
        </div>
      </form>
    </main>
  </div>
</Layout>
