---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { supabaseServer } from '../../lib/supabase';

const client = await supabaseServer(Astro.cookies);
const { data: berita } = await client
  .from('berita')
  .select('id, judul, slug, kategori, published, tanggal')
  .order('tanggal', { ascending: false });

const sukses = Astro.url.searchParams.get('sukses');

const badgeClass: Record<string, string> = {
  prestasi: 'bg-amber-500/15 text-amber-600',
  pengumuman: 'bg-brand-100 text-brand-700',
  ekstrakurikuler: 'bg-emerald-500/15 text-emerald-600',
};
---
<Layout title="Dashboard Admin — Portal Sekolah">
  <div class="min-h-screen bg-brand-50">
    <header class="bg-white border-b border-brand-100 sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
        <div>
          <p class="font-display font-extrabold text-lg">Panel Admin</p>
          <p class="text-xs text-ink/50">Kelola berita &amp; pengaturan website sekolah</p>
        </div>
        <div class="flex items-center gap-3">
          <a href="/" target="_blank" class="text-sm text-brand-600 font-semibold hover:underline hidden sm:inline">Lihat Situs ↗</a>
          <a href="/admin/fasilitas" class="text-sm bg-brand-50 hover:bg-brand-100 text-brand-700 font-semibold px-4 py-2 rounded-xl transition-colors">Kelola Fasilitas</a>
          <a href="/admin/pengaturan" class="text-sm bg-brand-50 hover:bg-brand-100 text-brand-700 font-semibold px-4 py-2 rounded-xl transition-colors">Pengaturan Situs</a>
          <form method="POST" action="/api/auth/logout">
            <button type="submit" class="text-sm bg-ink/5 hover:bg-ink/10 text-ink font-semibold px-4 py-2 rounded-xl transition-colors">Keluar</button>
          </form>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
      {sukses && (
        <p class="text-sm bg-emerald-50 text-emerald-700 border border-emerald-100 rounded-lg px-4 py-2.5 mb-6">{sukses}</p>
      )}

      <div class="flex items-center justify-between mb-6">
        <h1 class="font-display font-extrabold text-2xl">Daftar Berita</h1>
        <a href="/admin/berita/new" class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-semibold px-4 py-2.5 rounded-xl transition-colors text-sm">
          <i class="fa-solid fa-plus"></i> Tambah Berita
        </a>
      </div>

      <div class="bg-white rounded-2xl border border-brand-100 overflow-hidden">
        {(!berita || berita.length === 0) ? (
          <p class="text-center text-ink/50 py-14">Belum ada berita. Klik "Tambah Berita" untuk mulai menulis.</p>
        ) : (
          <table class="w-full text-sm">
            <thead class="bg-brand-50 text-ink/60 text-left">
              <tr>
                <th class="px-5 py-3 font-semibold">Judul</th>
                <th class="px-5 py-3 font-semibold">Kategori</th>
                <th class="px-5 py-3 font-semibold">Tanggal</th>
                <th class="px-5 py-3 font-semibold">Status</th>
                <th class="px-5 py-3 font-semibold text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-50">
              {berita.map((item) => (
                <tr>
                  <td class="px-5 py-3.5 font-medium">{item.judul}</td>
                  <td class="px-5 py-3.5">
                    <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${badgeClass[item.kategori]}`}>{item.kategori}</span>
                  </td>
                  <td class="px-5 py-3.5 text-ink/60">{new Date(item.tanggal).toLocaleDateString('id-ID')}</td>
                  <td class="px-5 py-3.5">
                    {item.published ? (
                      <span class="text-xs font-semibold text-emerald-600">Terbit</span>
                    ) : (
                      <span class="text-xs font-semibold text-ink/40">Draft</span>
                    )}
                  </td>
                  <td class="px-5 py-3.5 text-right space-x-3">
                    {item.published && (
                      <a href={`/berita/${item.slug}`} target="_blank" class="text-ink/50 hover:underline font-medium">Lihat</a>
                    )}
                    <a href={`/admin/berita/${item.id}/edit`} class="text-brand-600 hover:underline font-medium">Ubah</a>
                    <form method="POST" action="/api/berita/delete" class="inline" onsubmit="return confirm('Hapus berita ini?')">
                      <input type="hidden" name="id" value={item.id} />
                      <button type="submit" class="text-red-500 hover:underline font-medium">Hapus</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </main>
  </div>
</Layout>
