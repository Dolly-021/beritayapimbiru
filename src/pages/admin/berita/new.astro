---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import FormBerita from '../../../components/FormBerita.astro';

const error = Astro.url.searchParams.get('error');
---
<Layout title="Tambah Berita — Panel Admin">
  <div class="min-h-screen bg-brand-50">
    <header class="bg-white border-b border-brand-100">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 py-5">
        <a href="/admin" class="text-sm text-ink/50 hover:text-brand-600">&larr; Kembali ke Dashboard</a>
        <h1 class="font-display font-extrabold text-2xl mt-1">Tambah Berita Baru</h1>
      </div>
    </header>
    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
      <FormBerita action="/api/berita/create" submitLabel="Simpan Berita" error={error} />
    </main>
  </div>
</Layout>
