---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Halaman Tidak Ditemukan">
  <div class="min-h-screen flex flex-col items-center justify-center text-center px-4 bg-brand-50">
    <p class="font-display font-extrabold text-6xl text-brand-600">404</p>
    <h1 class="font-display font-bold text-2xl mt-3">Halaman tidak ditemukan</h1>
    <p class="text-ink/60 mt-2">Berita atau halaman yang kamu cari mungkin sudah dihapus atau belum dipublikasikan.</p>
    <a href="/" class="mt-6 inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-3 rounded-xl transition-colors">
      Kembali ke Beranda
    </a>
  </div>
</Layout>
