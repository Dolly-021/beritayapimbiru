# Ambil nilai ini dari Supabase Dashboard > Project Settings > API
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-public-key

# HANYA dipakai di server (API routes), JANGAN pernah expose ke client.
# Ambil di Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-service-role-key
